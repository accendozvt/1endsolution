# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Lighthouse reports (raw JSON, regenerate with seo-audit/run-lighthouse.sh)
/seo-audit/baseline/*.json
/seo-audit/final/*.json
/seo-audit/*/lh-errors.log
/seo-audit/*.log
/seo-audit/html-snapshot/
/seo-audit/final-scores-table.md
